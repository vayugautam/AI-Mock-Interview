# Database connection string
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mock_interview
# Quick local SQLite option:
DATABASE_URL=sqlite:///./mock_interview.db

# Generate a strong secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# LLM provider settings (used exclusively by app/llm.py)
# Groq example:   LLM_BASE_URL=https://api.groq.com/openai/v1  | LLM_MODEL=llama-3.3-70b-versatile
# OpenAI example: LLM_BASE_URL=https://api.openai.com/v1       | LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Qdrant vector database URL
QDRANT_URL=http://localhost:6333

# Whisper model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base

# Score fusion strategy: feature_level | decision_level
FUSION_METHOD=feature_level
