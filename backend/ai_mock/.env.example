APP_NAME=AI Mock Interview Platform API
APP_ENV=development
APP_DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_mock_interview
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
EVALUATION_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
QUESTION_GENERATION_PROVIDER=predefined
QUESTION_GENERATION_MAX_QUESTIONS=10
RESUME_STORAGE_DIR=storage/resumes
RESUME_MAX_SIZE_BYTES=5242880
COMPANY_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=8
COMPANY_RESEARCH_MAX_SEARCH_CALLS=3
COMPANY_RESEARCH_MAX_PAGES=5
COMPANY_RESEARCH_MAX_CONTENT_BYTES=200000
COMPANY_RESEARCH_MAX_SEARCH_CONTENT_BYTES=100000
COMPANY_RESEARCH_TIMEOUT_SECONDS=8
COMPANY_RESEARCH_MAX_RETRIES=1
COMPANY_RESEARCH_USER_AGENT=AI-Mock-Interview-Platform/1.0
COMPANY_RESEARCH_CACHE_TTL_HOURS=24
