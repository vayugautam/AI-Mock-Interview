# Primary provider for JD/resume extraction, question generation, answer scoring,
# embeddings, grounded web research, and voice transcription.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: fallback for text generation, recent web research, and voice transcription when Gemini fails.
GROQ_API_KEY=your_groq_api_key_here
# Optional: defaults to openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: date-filtered public interview-experience search (fallbacks remain available without it).
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: the active Express + Vite server defaults to port 3000.
PORT=3000
